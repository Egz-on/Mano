# Application
SECRET_KEY=change_this
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000

# PostgreSQL container initialization
POSTGRES_USER=mano
POSTGRES_PASSWORD=mano123
POSTGRES_DB=mano_db

# Database connection for local app execution
# Docker Compose overrides DB_HOST/DB_PORT for the app container automatically.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=mano_db
DB_USER=mano
DB_PASSWORD=mano123
DATABASE_URL=postgresql+asyncpg://mano:mano123@localhost:5434/mano_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# SMTP / Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SENDER_EMAIL=noreply@mano.local
SMTP_SENDER_NAME=Mano

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
